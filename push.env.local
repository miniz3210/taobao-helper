# 1. Navigate to your project directory
cd /opt/taobao-helper

# 2. Stage all updated files
git add .

# 3. Commit your updates
git commit -m "feat: release v0.0.2 updates and env path fixes"

# 4. Tag the new release locally
git tag -a v0.0.2 -m "Release v0.0.2"

# 5. Push the branch and tag to GitHub
git push origin main
git push origin v0.0.2

# 6. Log in to GitHub Container Registry (if not already logged in)
# Replace YOUR_GITHUB_PAT with your Personal Access Token (requires write:packages scope)
echo "YOUR_GITHUB_PAT" | docker login ghcr.io -u miniz3210 --password-stdin

# 7. Build and tag the Docker image
docker build -t ghcr.io/miniz3210/taobao-helper:v0.0.2 -t ghcr.io/miniz3210/taobao-helper:latest .

# 8. Push the Docker images to GHCR
docker push ghcr.io/miniz3210/taobao-helper:v0.0.2
docker push ghcr.io/miniz3210/taobao-helper:latest
